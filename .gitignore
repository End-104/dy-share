# 虚拟环境与缓存，体积大且可由 requirements.txt 重建
.venv312/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# IDE 与本地临时文件
.idea/
.vscode/
*.swp
Thumbs.db
desktop.ini

# 历史备份包
_deleted_*.zip
*.7z

# 推送脚本运行时的本地令牌缓存与日志
.github_token
push.log
*.log

# 远端校验的一次性脚本
_verify_remote.py

# 一次性探针脚本：内嵌 app_id/app_secret，只在本地使用
_peek_*.py
_set_state.py

# SQLite 运行时日志
*.db-wal
*.db-shm
*.db-journal

# 运行时状态：锁与基线台账都是「本机的事实」，跟着仓库走会把别的机器上的
# 起点（基线条数）和别人的 pid 一起带过来 —— 带的 pid 死不掉会让守护一直 exit 3，
# 带的旧基线会让新单按别的机器的起点算缺量。都在本机生成。
intake.lock
order_*.lock
baseline/
intake_state.json
pace_state.json

